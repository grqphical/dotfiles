[core]
    editor = "nvim"

[user]
    email = nathan@nathanjacobson.ca
    name = Nathan Jacobson
[include]
    path = ~/.gitconfig.local

[init]
    defaultBranch = "main"
[commit]
    gpgSign = true
[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[color "diff"]
    meta = black bold
    frag = magenta
    context = white
    whitespace = yellow reverse
    old = red
[push]
    autoSetupRemote = true
    default = current
    followTags = true

[pull]
    default = current
    rebase = true

[rebase]
    autoStash = true
    missingCommitsCheck = warn

[log]
    abbrevCommit = true
    graphColors  = blue,yellow,cyan,magenta,green,red

[color "decorate"]
    HEAD = red
    branch = blue
    tag = yellow
    remoteBranch = magenta
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
